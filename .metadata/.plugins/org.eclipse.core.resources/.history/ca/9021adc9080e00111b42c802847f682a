/* TIM2 is on APB1. If APB1 prescaler != 1, timer clock = 2*PCLK1. */
static uint32_t TIM2_GetClockHz(void)
{
  uint32_t pclk1 = HAL_RCC_GetPCLK1Freq();
  uint32_t ppre1 = (RCC->CFGR & RCC_CFGR_PPRE1) >> RCC_CFGR_PPRE1_Pos;

  /* PPRE1 encoding: 0xxx => DIV1, 100 => DIV2, 101 => DIV4, 110 => DIV8, 111 => DIV16 */
  if (ppre1 < 4U) {
    return pclk1;        // APB1 prescaler = 1
  } else {
    return 2U * pclk1;   // timer clock doubled when APB prescaler > 1
  }
}

static uint32_t TIM2_GetSampleRateHz(void)
{
  uint32_t timclk = TIM2_GetClockHz();
  uint32_t psc = (uint32_t)htim2.Init.Prescaler + 1U;
  uint32_t arr = (uint32_t)htim2.Init.Period + 1U;
  return (timclk / (psc * arr));
}

static void BuildSineLUT(void)
{
  for (uint32_t i = 0; i < LUT_SIZE; i++)
  {
    float theta = TWO_PI_F * ((float)i / (float)LUT_SIZE);
    float s = sinf(theta);

    /* Map [-1,1] to ~[DAC_MID-AMP, DAC_MID+AMP] */
    int32_t v = (int32_t)DAC_MID_12B + (int32_t)((float)DAC_AMP_2OVER3 * s);

    if (v < 0) v = 0;
    if (v > (int32_t)DAC_MAX_12B) v = (int32_t)DAC_MAX_12B;

    g_sine_lut[i] = (uint16_t)v;
  }
}

/* Button interrupt: toggle LED */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
  if (GPIO_Pin == GPIO_PIN_13)   // your button is on PC13 in MX_GPIO_Init
  {
    HAL_GPIO_TogglePin(LED_GPIO_Port, LED_Pin);
  }
}

/* Timer interrupt: update DAC sample (Part 1 requirement) */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if (htim->Instance == TIM2)
  {
    /* Top 8 bits select LUT index (since LUT_SIZE = 256) */
    uint32_t idx = (g_phase_acc >> 24) & (LUT_SIZE - 1U);

    HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, g_sine_lut[idx]);

    g_phase_acc += g_phase_inc;
  }
}
