  MX_GPIO_Init();
  MX_DMA_Init();
  MX_DAC1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  /* 1) Build sine waveform table */
   BuildSineLUT();

   /* 2) Compute phase increment for target tone frequency */
   uint32_t fs = TIM2_GetSampleRateHz();   // samples/sec (timer update rate)
   if (fs == 0U) fs = 1U;                  // safety
   /* phase_inc = f_out * 2^32 / fs */
   g_phase_inc = (uint32_t)(((uint64_t)TARGET_TONE_HZ << 32) / (uint64_t)fs);

