#define LUT_SIZE            256U
#define TARGET_TONE_HZ      1500U   // Lab says ~1–2 kHz is good
#define DAC_MAX_12B         4095U
#define DAC_MID_12B         2048U
#define DAC_AMP_2OVER3      1365U   // ~ (4095/3) gives ~2/3 dynamic range peak-to-peak
#define TWO_PI_F            6.28318530717958647692f
/* USER CODE END PD */

