     Error_Handler();
   }

   /* Set an initial value so output isn’t undefined before first tick */
   HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, g_sine_lut[0]);

   /* IMPORTANT: this starts the timer AND enables its IRQ callback */
   if (HAL_TIM_Base_Start_IT(&htim2) != HAL_OK)
   {
     Error_Handler();
   }
  /* USER CODE END 2 */

